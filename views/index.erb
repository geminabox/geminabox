<div class="intro">
  <p class="hint">If you did not need any credentials to get to this page</p>
  <code class="command">gem sources -a <%= url "/" %></code>
  <p class="hint">If you needed some credentials to get to this page</p>
  <code class="command">gem sources -a <%= url.to_s.gsub('://','://username:password@') %></code>
  <% if @allow_upload %>
  <p class="hint">and then ...</p>
  <code class="command">gem install geminabox<br />gem inabox [gemfile]</code>
  <% end %>
</div>

<% if @gems.any? %>
  <% if @allow_upload %><p class="upload-link"><a href="<%= url("/upload") %>">Upload Another Gem</a></p><% end %>

  <nav id="alpha_index">
    <% ("a".."z").each do |i| %>
      <% if @index_gems.include?(i) %><a href="#jump_<%= i %>"><%= i %></a><% else %><span><%= i %></span><% end %>
    <% end %>
  </nav>

  <ul class="gemlist">

    <% @gems.by_name do |name, versions| %>
      <li <%= %{id="jump_#{name[0..0].downcase}"} if @index_gems.delete(name[0..0].downcase) %> class="gem-card">
        <div class="card-header">
          <h2><%= h(name) %> (<%= h(versions.count == 1 ? versions.first.number : "#{versions.oldest.number} - #{versions.newest.number}") %>)</h2>
        </div>
        <div class="card-body">
          <% versions.each.reverse_each.first(5).each do |version| %>
            <div class="version-row">
              <code>gem install <%= h(version.name) %><%= " --prerelease" if version.number.to_s.match(/[a-z]/i) %> -v "<%= h(version.number) %>"</code>
              <% unless version.platform =~ /^ruby/i %>
                <small class="platform"><%= h(version.platform) %></small>
              <% end %>
              <div class="actions">
                <a class="download" href="<%= h(url("/gems/#{version.gemfile_name}.gem")) %>">download</a>
                <% if @allow_delete %>
                <form class="delete-form" method="post" action="<%= h(url("/gems/#{version.gemfile_name}.gem")) %>" data-gem-name="<%= h(version.name) %>" data-version="<%= h(version.number) %>" data-platform="<%= h(version.platform) %>">
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit">delete</button>
                </form>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if versions.count > 5 %>
            <div class="more-link"><a href="<%= h(url("/gems/#{name}")) %>">Older versions...</a></div>
          <% end %>
        </div>

        <div class="card-footer">
          <% newest_gem = versions.newest %>
          <% if spec = spec_for(name, newest_gem.number, newest_gem.platform) %>
            <p><%= h(spec.description) %></p>
            <p class="author">– <%= spec.authors.map do |author|
              "<a href='#{href(spec.homepage)}'>#{h(author)}</a>"
            end.join(', ') %></p>
          <% end %>
        </div>

      </li>
    <% end %>
  </ul>
<% end %>

<% if @allow_upload %><p class="upload-link"><a href="<%= url("/upload") %>">Upload Another Gem</a></p><% end %>
