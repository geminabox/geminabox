<div class="intro">
  <p class="hint">Add this server to your Gemfile, then paste gem lines from below into the block</p>
  <code class="command snippet">source "<%= h(url("/")) %>" do
  gem "..."
end</code>
  <p class="hint">If you needed credentials to get to this page</p>
  <code class="command">bundle config set --global <%= h(URI(url("/")).host) %> username:password</code>
  <p class="hint">Without Bundler</p>
  <code class="command">gem install GEMNAME --source <%= h(url("/")) %></code>
  <% if @allow_upload %>
  <p class="hint">and then ...</p>
  <code class="command">gem install geminabox<br />gem inabox [gemfile]</code>
  <% end %>
</div>

<% if @gems.any? %>
  <% if @allow_upload %><p class="upload-link"><a href="<%= url("/upload") %>">Upload Another Gem</a></p><% end %>

  <nav id="alpha_index">
    <% ("a".."z").each do |i| %>
      <% if @index_gems.include?(i) %><a href="#jump_<%= i %>"><%= i %></a><% else %><span><%= i %></span><% end %>
    <% end %>
  </nav>

  <ul class="gemlist">

    <% @gems.by_name do |name, versions| %>
      <li <%= %{id="jump_#{name[0..0].downcase}"} if @index_gems.delete(name[0..0].downcase) %> class="gem-card">
        <div class="card-header" id="gem_<%= h(name) %>">
          <h2><%= h(name) %> (<%= h(versions.count == 1 ? versions.first.number : "#{versions.oldest.number} - #{versions.newest.number}") %>)<a class="permalink" href="#gem_<%= h(name) %>" title="Permalink to <%= h(name) %>" aria-label="Permalink to <%= h(name) %>"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" y1="12" x2="16" y2="12"></line></svg></a></h2>
        </div>
        <div class="card-body">
          <% versions.each.reverse_each.first(5).each do |version| %>
            <%= erb :_version_row, layout: false, locals: { version: version } %>
          <% end %>

          <% if versions.count > 5 %>
            <div class="more-link"><a href="<%= h(url("/gems/#{name}")) %>">Older versions...</a></div>
          <% end %>
        </div>

        <div class="card-footer">
          <% newest_gem = versions.newest %>
          <% if spec = spec_for(name, newest_gem.number, newest_gem.platform) %>
            <p><%= h(spec.description) %></p>
            <p class="author">– <%= spec.authors.map do |author|
              "<a href='#{href(spec.homepage)}'>#{h(author)}</a>"
            end.join(', ') %></p>
          <% end %>
        </div>

      </li>
    <% end %>
  </ul>
<% end %>

<% if @allow_upload %><p class="upload-link"><a href="<%= url("/upload") %>">Upload Another Gem</a></p><% end %>
